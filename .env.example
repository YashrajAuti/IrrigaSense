# IrrigaSense Environment Configuration Template
# Copy this file to .env and configure your local settings

# Backend Settings
PROJECT_NAME="IrrigaSense Backend API"
VERSION="1.0.0"
DEMO_MODE=true
DATABASE_URL="sqlite:///./irrigasense.db"
MAX_IRRIGATION_RUNTIME_MINUTES=120
DEFAULT_EFFICIENCY_PERCENT=85.0

# Frontend Settings (optional overrides)
VITE_API_URL="http://127.0.0.1:8000"

# Optional External Weather Service (IMD / OpenWeatherMap)
WEATHER_API_KEY=""
WEATHER_API_ENDPOINT="https://api.openweathermap.org/data/2.5"

# Hardware Ingestion Gateway Secret (optional for physical ESP32 nodes)
HARDWARE_AUTH_SECRET="demo-hw-secret-key"
